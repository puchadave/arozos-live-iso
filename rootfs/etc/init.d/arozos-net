#!/sbin/openrc-run
name="ArozOS live DHCP"
description="Bring up the first usable Ethernet interface with udhcpc"

depend() {
    need arozos-mode
    before arozos arozos-pxe-se
}

start() {
    local mode p iface
    mode=$(cat /run/arozos-mode 2>/dev/null || echo live)
    case "$mode" in
        live|debug|pxe-se) ;;
        *)
            einfo "Network auto-DHCP disabled in boot mode: $mode"
            return 0
            ;;
    esac

    ebegin "Configuring live network"
    for p in /sys/class/net/*; do
        [ -e "$p" ] || continue
        iface=${p##*/}
        [ "$iface" = "lo" ] && continue
        ip link set dev "$iface" up 2>/dev/null || continue

        if ip -4 addr show dev "$iface" scope global 2>/dev/null | grep -q 'inet '; then
            printf '%s\n' "$iface" > /run/arozos-live-iface
            eend 0
            return 0
        fi

        if udhcpc -i "$iface" -q -n -t 5 >/dev/null 2>&1; then
            printf '%s\n' "$iface" > /run/arozos-live-iface
            eend 0
            return 0
        fi
    done
    eend 1 "no DHCP lease; system remains available on local console"
    return 0
}
